diff --git a/main/main.c b/main/main.c
index b510c67..f81e5f2 100644
--- a/main/main.c
+++ b/main/main.c
@@ -27,6 +27,9 @@ static esp_err_t send_with_retry(const uint8_t *frame, size_t len)
         if (err == ESP_OK) {
             return ESP_OK;
         }
+        /* link_send only takes ownership of pkt.data on ESP_OK; on error the
+         * caller still owns it, so free it before retrying. */
+        free(pkt.data);
         ESP_LOGW(TAG, "send failed (%s), retrying", esp_err_to_name(err));
         retries++;
     }

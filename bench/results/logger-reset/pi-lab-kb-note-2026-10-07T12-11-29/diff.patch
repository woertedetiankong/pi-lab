     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # On the ESP32-S3's USB-Serial/JTAG port, RTS high with DTR low resets the chip, and pyserial sets DTR before

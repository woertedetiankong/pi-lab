diff --git a/tools/logger.py b/tools/logger.py
index 017d4d7..d04b3e8 100644
--- a/tools/logger.py
+++ b/tools/logger.py
@@ -31,9 +31,13 @@ def default_port():
 def open_board(port):
     s = serial.Serial()
     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # The board's console is the ESP32-S3 USB Serial/JTAG peripheral. Deasserting
+    # DTR (s.dtr = False) is interpreted by that peripheral as a chip-reset
+    # request, so an attaching host would reboot the board on every connection.
+    # Keep DTR and RTS asserted instead; the board then keeps running while we
+    # attach and detach.
+    s.dtr = True
+    s.rts = True
     s.open()
     return s
 

diff --git a/main/main.c b/main/main.c
index 148bd27..ea0a3bd 100644
--- a/main/main.c
+++ b/main/main.c
@@ -9,7 +9,8 @@ static const char *TAG = "sensor";
 
 #define FIFO_BURST        5    /* readings the sensor FIFO holds per burst */
 #define BURST_INTERVAL_MS 500
-#define QUEUE_LEN         4
+#define QUEUE_LEN         8    /* >= FIFO_BURST so a whole burst fits without blocking */
+#define LINE_LEN          48
 
 static QueueHandle_t readings;
 
@@ -21,14 +22,14 @@ static int fake_temperature(uint32_t seq)
 
 static void sensor_task(void *arg)
 {
-    char line[48];
+    char line[LINE_LEN];
     uint32_t seq = 0;

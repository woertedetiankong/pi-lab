diff --git a/main/bmi270.c b/main/bmi270.c
index 59d5db3..8742dc5 100644
--- a/main/bmi270.c
+++ b/main/bmi270.c
@@ -11,7 +11,7 @@ static const char *TAG = "bmi270";
 #define BMI270_ACC_DATA        0x0C
 #define BMI270_INTERNAL_STATUS 0x21
 #define BMI270_ACC_CONF        0x40
-#define BMI270_ACC_RANGE       0x42
+#define BMI270_ACC_RANGE       0x41
 #define BMI270_INIT_CTRL       0x59
 #define BMI270_INIT_ADDR_0     0x5B
 #define BMI270_INIT_ADDR_1     0x5C
@@ -56,7 +56,28 @@ static void upload_config(void)
         i2c_master_transmit(dev, chunk, sizeof chunk, 100);
     }
     write_reg(BMI270_INIT_CTRL, 0x01);
-    vTaskDelay(pdMS_TO_TICKS(30));
+}
+
+/* The BMI270 reports a successful config load as INTERNAL_STATUS.message == init_ok (0x01). */
+static esp_err_t wait_for_init_ok(void)
+{
+    for (int i = 0; i < 50; i++) {
+        uint8_t status = 0;
+        esp_err_t err = read_regs(BMI270_INTERNAL_STATUS, &status, 1);
+        if (err != ESP_OK) {
+            return err;
+        }
+        if ((status & 0x0F) == 0x01) {
+            return ESP_OK;
+        }
+        if ((status & 0x0F) >= 0x02) { /* init_err, drv_err, ... */
+            ESP_LOGE(TAG, "internal status 0x%02x", status);
+            return ESP_ERR_INVALID_STATE;
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    ESP_LOGE(TAG, "config load timed out");
+    return ESP_ERR_TIMEOUT;
 }
 
 esp_err_t bmi270_init(i2c_master_bus_handle_t bus)
@@ -71,12 +92,22 @@ esp_err_t bmi270_init(i2c_master_bus_handle_t bus)
     write_reg(BMI270_CMD, 0xB6); /* soft reset */
     vTaskDelay(pdMS_TO_TICKS(20));
 
+    /* Datasheet 4.4: advanced power save must be disabled before the config load. */
+    write_reg(BMI270_PWR_CONF, 0x00);
+    vTaskDelay(pdMS_TO_TICKS(1)); /* >= 450 us */
+
     upload_config();
 
-    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off */
+    esp_err_t err = wait_for_init_ok();
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "config load failed: %s", esp_err_to_name(err));
+        return err;
+    }
+
     write_reg(BMI270_PWR_CTRL, 0x04);  /* accelerometer on */
     write_reg(BMI270_ACC_CONF, 0xA8);  /* 100 Hz, normal mode */
-    write_reg(BMI270_ACC_RANGE, ACC_RANGE_2G);
+    write_reg(BMI270_ACC_RANGE, ACC_RANGE_2G);  /* +/-2 g */
+    vTaskDelay(pdMS_TO_TICKS(100));  /* let the first samples become available */
 
     ESP_LOGI(TAG, "init done");
     return ESP_OK;

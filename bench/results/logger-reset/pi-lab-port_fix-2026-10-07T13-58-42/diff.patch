@@ -31,10 +31,14 @@ def default_port():
 def open_board(port):
     s = serial.Serial()
     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # On the ESP32-S3's native USB-Serial/JTAG console, DTR low with RTS high resets the chip. The OS raises both
+    # lines when the port is opened, and pyserial's open() then applies DTR before RTS; asking for DTR low first
+    # would pass through that reset state. So open with both high and, once open, lower RTS before DTR.
+    s.dtr = True
+    s.rts = True
     s.open()
+    s.rts = False
+    s.dtr = False
     return s
 
 

diff --git a/main/bmi270.c b/main/bmi270.c
index 59d5db3..44e43df 100644
--- a/main/bmi270.c
+++ b/main/bmi270.c
@@ -1,6 +1,7 @@
 #include "bmi270.h"
 #include <string.h>
 #include "esp_log.h"
+#include "esp_rom_sys.h"
 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
 
@@ -8,10 +9,11 @@ static const char *TAG = "bmi270";
 
 #define BMI270_ADDR            0x68
 #define BMI270_CHIP_ID         0x00
+#define BMI270_STATUS          0x03
 #define BMI270_ACC_DATA        0x0C
 #define BMI270_INTERNAL_STATUS 0x21
 #define BMI270_ACC_CONF        0x40
-#define BMI270_ACC_RANGE       0x42
+#define BMI270_ACC_RANGE       0x41
 #define BMI270_INIT_CTRL       0x59
 #define BMI270_INIT_ADDR_0     0x5B
 #define BMI270_INIT_ADDR_1     0x5C
@@ -71,15 +73,31 @@ esp_err_t bmi270_init(i2c_master_bus_handle_t bus)
     write_reg(BMI270_CMD, 0xB6); /* soft reset */
     vTaskDelay(pdMS_TO_TICKS(20));
 
+    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off (required BEFORE config load) */
+    esp_rom_delay_us(1000);
+
     upload_config();
 
-    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off */
-    write_reg(BMI270_PWR_CTRL, 0x04);  /* accelerometer on */
+    /* Configure the accelerometer while it is still disabled (changes to ACC_CONF/ACC_RANGE
+     * only take effect on the next ODR cycle when the sensor is already enabled). */
     write_reg(BMI270_ACC_CONF, 0xA8);  /* 100 Hz, normal mode */
     write_reg(BMI270_ACC_RANGE, ACC_RANGE_2G);
+    write_reg(BMI270_PWR_CTRL, 0x04);  /* accelerometer on */
 
-    ESP_LOGI(TAG, "init done");
-    return ESP_OK;
+    /* Wait until the accelerometer has its first sample ready (STATUS.drdy_acc, bit 7),
+     * so the very first logged reading is a real sample instead of zeros. */
+    for (int ms = 0; ms < 500; ms++) {
+        uint8_t st = 0;
+        if (read_regs(BMI270_STATUS, &st, 1) == ESP_OK && (st & 0x80)) {
+            break;
+        }
+        vTaskDelay(pdMS_TO_TICKS(1));
+    }
+
+    uint8_t status = 0;
+    read_regs(BMI270_INTERNAL_STATUS, &status, 1);
+    ESP_LOGI(TAG, "init done, internal status 0x%02x", status & 0x0F);
+    return (status & 0x0F) == 0x01 ? ESP_OK : ESP_ERR_INVALID_STATE;
 }
 
 esp_err_t bmi270_read_accel(bmi270_accel_t *out)

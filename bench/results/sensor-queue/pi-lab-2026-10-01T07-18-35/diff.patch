diff --git a/main/main.c b/main/main.c
index 148bd27..5009771 100644
--- a/main/main.c
+++ b/main/main.c
@@ -10,6 +10,13 @@ static const char *TAG = "sensor";
 #define FIFO_BURST        5    /* readings the sensor FIFO holds per burst */
 #define BURST_INTERVAL_MS 500
 #define QUEUE_LEN         4
+#define LINE_LEN          48
+
+/* One reading, carried by value through the queue. A pointer to a reused
+ * buffer would alias, so the formatted text is copied into the queue item. */
+typedef struct {
+    char text[LINE_LEN];
+} reading_msg_t;
 
 static QueueHandle_t readings;
 
@@ -21,13 +28,12 @@ static int fake_temperature(uint32_t seq)
 
 static void sensor_task(void *arg)
 {
-    char line[48];
     uint32_t seq = 0;
     for (;;) {
         for (int i = 0; i < FIFO_BURST; i++, seq++) {
             int t = fake_temperature(seq);
-            snprintf(line, sizeof line, "seq=%" PRIu32 " temp=%d.%02d", seq, t / 100, t % 100);
-            char *msg = line;
+            reading_msg_t msg;
+            snprintf(msg.text, sizeof msg.text, "seq=%" PRIu32 " temp=%d.%02d", seq, t / 100, t % 100);
             if (xQueueSend(readings, &msg, pdMS_TO_TICKS(10)) != pdTRUE) {
                 ESP_LOGW(TAG, "queue full, reading %" PRIu32 " dropped", seq);
             }
@@ -38,19 +44,19 @@ static void sensor_task(void *arg)
 
 static void report_task(void *arg)
 {
-    char *msg;
+    reading_msg_t msg;
     for (;;) {
         if (xQueueReceive(readings, &msg, portMAX_DELAY) == pdTRUE) {

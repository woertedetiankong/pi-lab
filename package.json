{
  "name": "pi-lab",
  "version": "0.4.1",
  "description": "Embedded debugging for pi on the real board: flash and read it reliably, run controlled experiments, keep notes that re-run themselves, check fixes against acceptance criteria, and guard the toolchain; also an MCP server for other agents",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "assets",
    "boards",
    "web",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "embedded",
    "firmware",
    "debugging"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^24.13.6",
    "typebox": "^1.3.34",
    "typescript": "5.9"
  }
}

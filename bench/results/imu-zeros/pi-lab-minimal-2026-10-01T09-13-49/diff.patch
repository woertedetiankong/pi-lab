diff --git a/main/bmi270.c b/main/bmi270.c
index 59d5db3..1b19323 100644
--- a/main/bmi270.c
+++ b/main/bmi270.c
@@ -8,10 +8,11 @@ static const char *TAG = "bmi270";
 
 #define BMI270_ADDR            0x68
 #define BMI270_CHIP_ID         0x00
+#define BMI270_STATUS          0x03
 #define BMI270_ACC_DATA        0x0C
 #define BMI270_INTERNAL_STATUS 0x21
 #define BMI270_ACC_CONF        0x40
-#define BMI270_ACC_RANGE       0x42
+#define BMI270_ACC_RANGE       0x41
 #define BMI270_INIT_CTRL       0x59
 #define BMI270_INIT_ADDR_0     0x5B
 #define BMI270_INIT_ADDR_1     0x5C
@@ -71,13 +72,24 @@ esp_err_t bmi270_init(i2c_master_bus_handle_t bus)
     write_reg(BMI270_CMD, 0xB6); /* soft reset */
     vTaskDelay(pdMS_TO_TICKS(20));
 
+    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off, required before config load */
+    vTaskDelay(pdMS_TO_TICKS(1));      /* >= 450 us */
+
     upload_config();
 
-    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off */
     write_reg(BMI270_PWR_CTRL, 0x04);  /* accelerometer on */
     write_reg(BMI270_ACC_CONF, 0xA8);  /* 100 Hz, normal mode */
     write_reg(BMI270_ACC_RANGE, ACC_RANGE_2G);
 
+    /* Wait for the first accelerometer sample so the first reading is valid. */
+    uint8_t status = 0;
+    for (int i = 0; i < 100; i++) {
+        if (read_regs(BMI270_STATUS, &status, 1) == ESP_OK && (status & 0x80)) {
+            break;
+        }
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+
     ESP_LOGI(TAG, "init done");
     return ESP_OK;
 }

diff --git a/main/bmi270.c b/main/bmi270.c
index 59d5db3..c0a7f07 100644
--- a/main/bmi270.c
+++ b/main/bmi270.c
@@ -11,7 +11,7 @@ static const char *TAG = "bmi270";
 #define BMI270_ACC_DATA        0x0C
 #define BMI270_INTERNAL_STATUS 0x21
 #define BMI270_ACC_CONF        0x40
-#define BMI270_ACC_RANGE       0x42
+#define BMI270_ACC_RANGE       0x41
 #define BMI270_INIT_CTRL       0x59
 #define BMI270_INIT_ADDR_0     0x5B
 #define BMI270_INIT_ADDR_1     0x5C
@@ -71,9 +71,18 @@ esp_err_t bmi270_init(i2c_master_bus_handle_t bus)
     write_reg(BMI270_CMD, 0xB6); /* soft reset */
     vTaskDelay(pdMS_TO_TICKS(20));
 
+    /* Advanced power save (reset value 0x03) must be disabled BEFORE the config
+     * file is uploaded, otherwise the device ignores the upload and the sensors
+     * output zeros. See datasheet section 4.4 (POR and Device Initialization). */
+    write_reg(BMI270_PWR_CONF, 0x00);
+
     upload_config();
 
-    write_reg(BMI270_PWR_CONF, 0x00);  /* advanced power save off */
+    uint8_t status = 0;
+    if (read_regs(BMI270_INTERNAL_STATUS, &status, 1) == ESP_OK) {
+        ESP_LOGI(TAG, "internal status 0x%02x", status & 0x0F);
+    }
+
     write_reg(BMI270_PWR_CTRL, 0x04);  /* accelerometer on */
     write_reg(BMI270_ACC_CONF, 0xA8);  /* 100 Hz, normal mode */
     write_reg(BMI270_ACC_RANGE, ACC_RANGE_2G);

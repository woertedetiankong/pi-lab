diff --git a/tools/logger.py b/tools/logger.py
index 017d4d7..cfc72d4 100644
--- a/tools/logger.py
+++ b/tools/logger.py
@@ -31,10 +31,15 @@ def default_port():
 def open_board(port):
     s = serial.Serial()
     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # On the ESP32-S3 USB-Serial/JTAG port, RTS high with DTR low resets the chip, and DTR high with RTS low
+    # selects the boot strap. The OS raises both lines when the port is opened. pyserial then applies DTR before
+    # RTS, so pre-setting DTR/RTS low passes through (DTR=0, RTS=1) and resets the board. Open with both lines
+    # already high (the state the OS set up), then lower RTS before DTR so the reset state is never entered.
+    s.dtr = True
+    s.rts = True
     s.open()
+    s.rts = False
+    s.dtr = False
     return s
 
 

@@ -31,10 +31,15 @@ def default_port():
 def open_board(port):
     s = serial.Serial()
     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # On the ESP32-S3 USB-Serial/JTAG port, RTS high with DTR low resets the chip. pyserial applies
+    # DTR before RTS, so opening the port with both already low passes through exactly that
+    # combination and reboots the board. Open with both high (pyserial's default) and then lower RTS
+    # before DTR, so the lines end low without ever passing through the reset combination.
+    s.dtr = True
+    s.rts = True
     s.open()
+    s.rts = False
+    s.dtr = False
     return s
 
 

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Leave the chip in the bootloader after flashing: an RTS reset right after flashing can wedge the
# M5StickS3 USB port. tools/serial_capture.py resets the board and starts the firmware.
CONFIG_ESPTOOLPY_AFTER_NORESET=y

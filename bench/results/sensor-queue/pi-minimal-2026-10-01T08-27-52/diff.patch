+/* Each queued item owns its text so the sensor task can keep reusing one buffer. */
+typedef struct {
+    char text[48];
+} reading_t;
+
 static QueueHandle_t readings;
 
 /* Stand-in for the sensor: a deterministic temperature for each sample, in centi-degrees. */
@@ -21,14 +26,13 @@ static int fake_temperature(uint32_t seq)
 
 static void sensor_task(void *arg)
 {
-    char line[48];
+    reading_t reading;
     uint32_t seq = 0;
     for (;;) {
         for (int i = 0; i < FIFO_BURST; i++, seq++) {
             int t = fake_temperature(seq);
-            snprintf(line, sizeof line, "seq=%" PRIu32 " temp=%d.%02d", seq, t / 100, t % 100);
-            char *msg = line;
-            if (xQueueSend(readings, &msg, pdMS_TO_TICKS(10)) != pdTRUE) {
+            snprintf(reading.text, sizeof reading.text, "seq=%" PRIu32 " temp=%d.%02d", seq, t / 100, t % 100);
+            if (xQueueSend(readings, &reading, pdMS_TO_TICKS(10)) != pdTRUE) {
                 ESP_LOGW(TAG, "queue full, reading %" PRIu32 " dropped", seq);
             }
         }
@@ -38,19 +42,19 @@ static void sensor_task(void *arg)
 

diff --git a/tools/logger.py b/tools/logger.py
index 017d4d7..e07560c 100644
--- a/tools/logger.py
+++ b/tools/logger.py
@@ -31,10 +31,14 @@ def default_port():
 def open_board(port):
     s = serial.Serial()
     s.port, s.baudrate, s.timeout = port, 115200, 0.2
-    # Keep DTR and RTS low so that opening the port does not reset the ESP32.
-    s.dtr = False
-    s.rts = False
+    # On the ESP32-S3's USB-Serial/JTAG port, RTS high with DTR low resets the chip. Raising both lines on
+    # open and then lowering RTS before DTR avoids the "RTS high, DTR low" pass that a plain dtr=False,
+    # rts=False before open would go through, so connecting does not disturb the running firmware.
+    s.dtr = True
+    s.rts = True
     s.open()
+    s.rts = False
+    s.dtr = False
     return s
 
 
